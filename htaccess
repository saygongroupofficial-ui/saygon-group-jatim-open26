# ===== Perbaikan MIME type untuk font (khusus .woff2/.woff) =====
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/font-woff2 .woff2
</IfModule>

# ===== Izinkan font di-load lintas origin (perlu kalau situs pakai CDN/subdomain) =====
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|woff|ttf|otf|eot)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# ===== Cache font di browser biar loading lebih cepat =====
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(woff2|woff|ttf|otf)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>
